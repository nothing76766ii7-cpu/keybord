<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.keybord">

    <!-- Optional Permissions per PRD Section 5.2 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.WRITE_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ZERO INTERNET PERMISSION (Deliberate Trust Signal) -->

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keybord">

        <!-- Master InputMethodService -->
        <service
            android:name=".ime.KeybordIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- First Launch Onboarding Activity -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Keybord.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Root Settings Activity -->
        <activity
            android:name=".settings.KeybordSettingsActivity"
            android:exported="true"
            android:label="Keybord Settings"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <!-- Sub Settings Activities -->
        <activity
            android:name=".settings.ClipboardSettingsActivity"
            android:exported="false"
            android:label="Clipboard Settings"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <activity
            android:name=".settings.TypingSettingsActivity"
            android:exported="false"
            android:label="Typing Settings"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <activity
            android:name=".settings.PersonalDictionaryActivity"
            android:exported="false"
            android:label="Personal Dictionary"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <activity
            android:name=".settings.AboutActivity"
            android:exported="false"
            android:label="About Keybord"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <activity
            android:name=".settings.KeyboardLayoutCustomizeActivity"
            android:exported="false"
            android:label="Height &amp; Buttons"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <!-- Theme Management Activities -->
        <activity
            android:name=".theme.ThemeGalleryActivity"
            android:exported="true"
            android:label="Theme Gallery"
            android:theme="@style/Theme.Keybord.NoActionBar">
            <!-- Intent filter to import .keybordtheme files from file manager or share sheet -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.keybordtheme" />
            </intent-filter>
        </activity>

        <activity
            android:name=".theme.CustomThemeEditorActivity"
            android:exported="false"
            android:label="Custom Theme Editor"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <!-- Full-screen Clipboard Manager -->
        <activity
            android:name=".clipboard.ClipboardActivity"
            android:exported="false"
            android:label="Clipboard History"
            android:theme="@style/Theme.Keybord.NoActionBar" />

        <!-- Runtime microphone permission helper for Voice Rambler -->
        <activity
            android:name=".voice.MicPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
